local cloneref = cloneref or function(o) return o end
local Players = cloneref(game:GetService("Players"))
local Workspace = cloneref(game:GetService("Workspace"))
local CoreGui = cloneref(game:GetService("CoreGui"))
local RunService = cloneref(game:GetService("RunService"))
local UserInputService = cloneref(game:GetService("UserInputService"))
local TweenService = cloneref(game:GetService("TweenService"))

local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()

local env = (getgenv and getgenv()) or _G
if env.ZenxhubBSLCleanup then
    pcall(env.ZenxhubBSLCleanup)
end

local function getGuiParent()
    if gethui then
        local ok, hui = pcall(gethui)
        if ok and hui then return hui end
    end
    local ok, core = pcall(function() return CoreGui end)
    if ok and core then return core end
    return LocalPlayer:WaitForChild("PlayerGui", 5)
end

local parentGui = getGuiParent()
local connections, cleanups = {}, {}

local function track(conn)
    table.insert(connections, conn)
    return conn
end

local function onCleanup(fn)
    table.insert(cleanups, fn)
end

local Theme = {
    Background = Color3.fromRGB(11, 11, 18),
    Panel = Color3.fromRGB(18, 18, 28),
    Element = Color3.fromRGB(26, 26, 40),
    Off = Color3.fromRGB(54, 54, 76),
    Stroke = Color3.fromRGB(46, 46, 68),
    Accent = Color3.fromRGB(0, 229, 255),
    LilyBlue = Color3.fromRGB(40, 175, 255),
    Text = Color3.fromRGB(240, 240, 248),
    SubText = Color3.fromRGB(150, 150, 176),
    Danger = Color3.fromRGB(255, 70, 90),
    Good = Color3.fromRGB(70, 220, 130),
}

local MainGui = Instance.new("ScreenGui")
MainGui.Name = "ZenxhubBlueSpiderLilyESP"
MainGui.ResetOnSpawn = false
MainGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
MainGui.DisplayOrder = 100
MainGui.Parent = parentGui

local EspGui = Instance.new("ScreenGui")
EspGui.Name = "ZenxhubBSLEspHolder"
EspGui.ResetOnSpawn = false
EspGui.IgnoreGuiInset = true
EspGui.Parent = parentGui

local MainFrame = Instance.new("Frame", MainGui)
MainFrame.Size = UDim2.fromOffset(250, 235)
MainFrame.Position = UDim2.new(0.04, 0, 0.3, 0)
MainFrame.BackgroundColor3 = Theme.Background
MainFrame.BackgroundTransparency = 0.08
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 10)
local mainStroke = Instance.new("UIStroke", MainFrame)
mainStroke.Thickness = 1.5
mainStroke.Color = Theme.LilyBlue

local TopBar = Instance.new("Frame", MainFrame)
TopBar.Size = UDim2.new(1, 0, 0, 32)
TopBar.BackgroundColor3 = Theme.Panel
TopBar.BorderSizePixel = 0
Instance.new("UICorner", TopBar).CornerRadius = UDim.new(0, 10)

local TitleLbl = Instance.new("TextLabel", TopBar)
TitleLbl.Size = UDim2.new(1, -40, 1, 0)
TitleLbl.Position = UDim2.fromOffset(10, 0)
TitleLbl.BackgroundTransparency = 1
TitleLbl.Font = Enum.Font.GothamBold
TitleLbl.Text = "💠 Blue Spider Lily ESP | Zelynx"
TitleLbl.TextColor3 = Theme.Accent
TitleLbl.TextSize = 11
TitleLbl.TextXAlignment = Enum.TextXAlignment.Left

local CloseBtn = Instance.new("TextButton", TopBar)
CloseBtn.Size = UDim2.fromOffset(22, 22)
CloseBtn.Position = UDim2.new(1, -27, 0.5, -11)
CloseBtn.BackgroundColor3 = Theme.Element
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.Text = "✕"
CloseBtn.TextColor3 = Theme.Danger
CloseBtn.TextSize = 11
Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(1, 0)

local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)
TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
track(UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end))
track(UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end))

local Content = Instance.new("Frame", MainFrame)
Content.Size = UDim2.new(1, -16, 1, -40)
Content.Position = UDim2.fromOffset(8, 36)
Content.BackgroundTransparency = 1
local layout = Instance.new("UIListLayout", Content)
layout.Padding = UDim.new(0, 6)
layout.SortOrder = Enum.SortOrder.LayoutOrder

local StatusLbl = Instance.new("TextLabel", Content)
StatusLbl.Size = UDim2.new(1, 0, 0, 26)
StatusLbl.BackgroundColor3 = Theme.Element
StatusLbl.Font = Enum.Font.GothamSemibold
StatusLbl.Text = "Đang tìm Blue Spider Lily..."
StatusLbl.TextColor3 = Theme.SubText
StatusLbl.TextSize = 11
Instance.new("UICorner", StatusLbl).CornerRadius = UDim.new(0, 6)

local function createToggle(name, default, callback)
    local btn = Instance.new("TextButton", Content)
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = Theme.Element
    btn.Text = ""
    btn.AutoButtonColor = false
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    local st = Instance.new("UIStroke", btn)
    st.Thickness = 1
    st.Color = Theme.Stroke

    local lbl = Instance.new("TextLabel", btn)
    lbl.Size = UDim2.new(1, -50, 1, 0)
    lbl.Position = UDim2.fromOffset(10, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamSemibold
    lbl.Text = name
    lbl.TextColor3 = Theme.Text
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local switch = Instance.new("Frame", btn)
    switch.Size = UDim2.fromOffset(34, 16)
    switch.Position = UDim2.new(1, -42, 0.5, -8)
    switch.BackgroundColor3 = Theme.Off
    Instance.new("UICorner", switch).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame", switch)
    knob.Size = UDim2.fromOffset(12, 12)
    knob.Position = UDim2.new(0, 2, 0.5, -6)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local state = default or false
    local function update(val)
        state = val
        TweenService:Create(switch, TweenInfo.new(0.15), { BackgroundColor3 = state and Theme.Accent or Theme.Off }):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), { Position = state and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6) }):Play()
        TweenService:Create(st, TweenInfo.new(0.15), { Color = state and Theme.Accent or Theme.Stroke }):Play()
        if callback then task.spawn(callback, state) end
    end

    btn.MouseButton1Click:Connect(function() update(not state) end)
    if state then update(true) end
    return { Get = function() return state end }
end

local function createButton(name, callback)
    local btn = Instance.new("TextButton", Content)
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = Theme.Panel
    btn.Font = Enum.Font.GothamBold
    btn.Text = name
    btn.TextColor3 = Theme.Accent
    btn.TextSize = 11
    btn.AutoButtonColor = false
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    local st = Instance.new("UIStroke", btn)
    st.Thickness = 1
    st.Color = Theme.Accent
    btn.MouseButton1Click:Connect(function()
        if callback then task.spawn(callback) end
    end)
    return btn
end

local Settings = {
    EspEnabled = true,
    ShowTracer = true,
    AutoCollect = false,
}

local trackedLilies = {}
local espObjects = {}
local tracerLines = {}

local function clearVisuals()
    for _, gui in pairs(espObjects) do
        pcall(function() gui:Destroy() end)
    end
    table.clear(espObjects)
    for _, line in pairs(tracerLines) do
        pcall(function() line:Remove() end)
    end
    table.clear(tracerLines)
end

env.ZenxhubBSLCleanup = function()
    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(connections)
    for _, fn in ipairs(cleanups) do
        pcall(fn)
    end
    table.clear(cleanups)
    clearVisuals()
    pcall(function() MainGui:Destroy() end)
    pcall(function() EspGui:Destroy() end)
    env.ZenxhubBSLCleanup = nil
end

CloseBtn.MouseButton1Click:Connect(function()
    if env.ZenxhubBSLCleanup then env.ZenxhubBSLCleanup() end
end)

track(UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == Enum.KeyCode.Z then
        MainGui.Enabled = not MainGui.Enabled
    end
end))

local function isBlueSpiderLily(inst)
    local lower = string.lower(inst.Name)
    if lower:find("spider") and lower:find("lily") then
        return true
    end
    if lower:find("bluelily") or lower:find("blue_lily") or lower:find("bluespider") then
        return true
    end
    return false
end

local function getTargetPart(inst)
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") then
        return inst.PrimaryPart or inst:FindFirstChild("Handle") or inst:FindFirstChildWhichIsA("BasePart", true)
    end
    if inst:IsA("Tool") then
        return inst:FindFirstChild("Handle") or inst:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function scanLilies()
    table.clear(trackedLilies)
    local char = LocalPlayer.Character
    local seenParts = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isBlueSpiderLily(obj) then
            local part = getTargetPart(obj)
            if part and part.Parent and not seenParts[part] and (not char or not part:IsDescendantOf(char)) then
                seenParts[part] = true
                table.insert(trackedLilies, { Root = obj, Part = part })
            end
        end
    end
end

local function createEspForPart(part)
    if espObjects[part] and espObjects[part].Parent then return espObjects[part] end

    local holder = Instance.new("Folder")
    holder.Name = "BSL_Visual"
    holder.Parent = EspGui

    local bb = Instance.new("BillboardGui")
    bb.Adornee = part
    bb.AlwaysOnTop = true
    bb.Size = UDim2.fromOffset(180, 36)
    bb.StudsOffset = Vector3.new(0, 2, 0)
    bb.Parent = holder

    local lbl = Instance.new("TextLabel", bb)
    lbl.Name = "DistLabel"
    lbl.Size = UDim2.fromScale(1, 1)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = "💠 Blue Spider Lily"
    lbl.TextColor3 = Theme.Accent
    lbl.TextStrokeTransparency = 0.2
    lbl.TextSize = 13

    local hl = Instance.new("Highlight")
    hl.Adornee = part.Parent:IsA("Model") and part.Parent or part
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = Theme.LilyBlue
    hl.OutlineColor = Color3.new(1, 1, 1)
    hl.FillTransparency = 0.35
    hl.OutlineTransparency = 0
    hl.Parent = holder

    espObjects[part] = holder
    return holder
end

local function interactAndCollect(entry)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (hrp and entry and entry.Part and entry.Part.Parent) then return end

    hrp.CFrame = entry.Part.CFrame * CFrame.new(0, 2, 0)
    task.wait(0.15)

    local prompt = entry.Root:FindFirstChildWhichIsA("ProximityPrompt", true) or entry.Part:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and fireproximityprompt then
        pcall(fireproximityprompt, prompt)
    end

    local click = entry.Root:FindFirstChildWhichIsA("ClickDetector", true) or entry.Part:FindFirstChildWhichIsA("ClickDetector", true)
    if click and fireclickdetector then
        pcall(fireclickdetector, click)
    end

    if firetouchinterest then
        pcall(function()
            firetouchinterest(hrp, entry.Part, 0)
            task.wait(0.05)
            firetouchinterest(hrp, entry.Part, 1)
        end)
    end
end

createToggle("Bật ESP Blue Spider Lily", true, function(v)
    Settings.EspEnabled = v
    if not v then clearVisuals() end
end)

createToggle("Hiện Đường Kẻ (Tracer)", true, function(v)
    Settings.ShowTracer = v
    if not v then
        for _, line in pairs(tracerLines) do
            pcall(function() line:Remove() end)
        end
        table.clear(tracerLines)
    end
end)

createToggle("Tự Động Dịch Chuyển Nhặt", false, function(v)
    Settings.AutoCollect = v
end)

createButton("⚡ Dịch Chuyển Đến Hoa Gần Nhất", function()
    scanLilies()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local nearest, minDist = nil, math.huge
    for _, entry in ipairs(trackedLilies) do
        if entry.Part and entry.Part.Parent then
            local d = (entry.Part.Position - hrp.Position).Magnitude
            if d < minDist then
                minDist = d
                nearest = entry
            end
        end
    end

    if nearest then
        interactAndCollect(nearest)
    end
end)

task.spawn(function()
    while env.ZenxhubBSLCleanup do
        scanLilies()
        local count = #trackedLilies
        if count > 0 then
            StatusLbl.Text = string.format("✅ Tìm thấy: %d Blue Spider Lily", count)
            StatusLbl.TextColor3 = Theme.Good
        else
            StatusLbl.Text = "❌ Chưa có Blue Spider Lily trên map"
            StatusLbl.TextColor3 = Theme.SubText
        end

        if Settings.AutoCollect and count > 0 then
            interactAndCollect(trackedLilies[1])
        end

        task.wait(1.2)
    end
end)

local hasDrawing = (Drawing ~= nil and Drawing.new ~= nil)

track(RunService.RenderStepped:Connect(function()
    if not Settings.EspEnabled then return end

    local cam = Workspace.CurrentCamera
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not cam then return end

    local activeParts = {}
    for _, entry in ipairs(trackedLilies) do
        local part = entry.Part
        if part and part.Parent then
            activeParts[part] = true
            local holder = createEspForPart(part)
            local dist = hrp and math.floor((part.Position - hrp.Position).Magnitude) or 0
            local bb = holder:FindFirstChildOfClass("BillboardGui")
            local lbl = bb and bb:FindFirstChild("DistLabel")
            if lbl then
                lbl.Text = string.format("💠 Blue Spider Lily [%dm]", dist)
            end

            if hasDrawing and Settings.ShowTracer then
                local line = tracerLines[part]
                if not line then
                    line = Drawing.new("Line")
                    line.Thickness = 1.5
                    line.Color = Theme.Accent
                    line.Transparency = 0.85
                    tracerLines[part] = line
                end
                local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
                if onScreen then
                    local vp = cam.ViewportSize
                    line.From = Vector2.new(vp.X / 2, vp.Y)
                    line.To = Vector2.new(screenPos.X, screenPos.Y)
                    line.Visible = true
                else
                    line.Visible = false
                end
            elseif tracerLines[part] then
                pcall(function() tracerLines[part]:Remove() end)
                tracerLines[part] = nil
            end
        end
    end

    for part, holder in pairs(espObjects) do
        if not activeParts[part] or not part.Parent then
            pcall(function() holder:Destroy() end)
            espObjects[part] = nil
        end
    end

    for part, line in pairs(tracerLines) do
        if not activeParts[part] or not part.Parent then
            pcall(function() line:Remove() end)
            tracerLines[part] = nil
        end
    end
end))
